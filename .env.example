# Nombres solamente. Los valores reales van en .env, que no se versiona.

# Clave de la cuenta de ElevenLabs. Solo la lee el servidor.
ELEVENLABS_API_KEY=

# Cliente OAuth de Google. El redirect local es http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secreto de la cookie de sesión. Generar uno largo y aleatorio.
AUTH_SECRET=

# Postgres local del docker-compose, o el gestionado cuando se apruebe el despliegue.
DATABASE_URL=

# Correos del instructor, separados por coma. Esas cuentas entran aunque no estén cargadas como estudiantes.
INSTRUCTOR_EMAILS=

# Opcional. Solo en el servidor público, detrás de HTTPS. En local se deja vacío.
HSTS=
